<?xml version="1.0"?>
<package format="2">
  <name>dagger</name>
  <version>0.0.1</version>
  <description>FluxDAgger data collection and control package</description>

  <maintainer email="hqr1092777015@gmail.com">Ryan Hu</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Runtime package for Python nodes and common messages. -->
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
